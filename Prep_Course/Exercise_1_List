#For all numbers between 1 and 100, return a list of the numbers that are divisible by 12: [12, 24, 36, 48, 60, 72, 84, 96].
n = 1
new_list = []
while n <= 100:
    if n % 12 == 0:
        new_list.append(n)
    n += 1
print(new_list)

